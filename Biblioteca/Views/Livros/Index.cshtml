@model List<Livro>
@{
    ViewData["Title"] = "Livros";
}
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="mb-0">Livros</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Novo livro</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3" role="search">
    <div class="col-md-5">
        <label for="pesquisa" class="visually-hidden">Pesquisar</label>
        <input type="search" id="pesquisa" name="pesquisa" value="@ViewData["Pesquisa"]" class="form-control" placeholder="Título, ISBN ou autor" />
    </div>
    <div class="col-md-3">
        <label for="categoriaId" class="visually-hidden">Categoria</label>
        <select id="categoriaId" name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Todas as categorias</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-funnel"></i> Filtrar</button>
        <a asp-action="Index" class="btn btn-link">Limpar</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-light border">Não foram encontrados livros.</div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Autor</th>
                        <th>Categoria</th>
                        <th>ISBN</th>
                        <th class="text-center">Disponíveis</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var livro in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@livro.Titulo <span class="text-muted fw-normal small">(@livro.AnoPublicacao)</span></td>
                            <td><a asp-controller="Autores" asp-action="Details" asp-route-id="@livro.AutorId">@livro.Autor?.Nome</a></td>
                            <td><span class="badge text-bg-light border">@livro.Categoria?.Nome</span></td>
                            <td class="font-monospace small">@livro.ISBN</td>
                            <td class="text-center">
                                <span class="badge @(livro.ExemplaresDisponiveis > 0 ? "text-bg-success" : "text-bg-danger")">
                                    @livro.ExemplaresDisponiveis / @livro.NumeroExemplares
                                </span>
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@livro.Id" class="btn btn-sm btn-outline-secondary" title="Detalhes" aria-label="Detalhes de @livro.Titulo"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@livro.Id" class="btn btn-sm btn-outline-primary" title="Editar" aria-label="Editar @livro.Titulo"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@livro.Id" class="btn btn-sm btn-outline-danger" title="Eliminar" aria-label="Eliminar @livro.Titulo"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
