@model Livro
@{
    ViewData["Title"] = "Eliminar livro";
    var temEmprestimos = Model.Emprestimos.Any();
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger"><i class="bi bi-trash"></i> Eliminar livro</h1>

                @if (temEmprestimos)
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Este livro tem <strong>@Model.Emprestimos.Count empréstimo(s)</strong> registado(s) e não pode ser eliminado,
                        para preservar o histórico.
                    </div>
                }
                else
                {
                    <p>Tem a certeza de que pretende eliminar este livro?</p>
                }

                <dl class="row">
                    <dt class="col-sm-4">Título</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>
                    <dt class="col-sm-4">Autor</dt>
                    <dd class="col-sm-8">@Model.Autor?.Nome</dd>
                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>
                </dl>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger" disabled="@temEmprestimos">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
