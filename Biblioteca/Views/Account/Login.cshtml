@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sessão";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card card-form">
            <div class="card-body p-4">
                <h1 class="h3 mb-4 text-center"><i class="bi bi-box-arrow-in-right"></i> Iniciar sessão</h1>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                        <span asp-validation-for="Username" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Entrar</button>
                </form>

                <hr />
                <div class="d-flex justify-content-between small">
                    <a asp-action="RecoverPassword">Esqueceu-se da palavra-passe?</a>
                    <a asp-action="Register">Criar conta</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}