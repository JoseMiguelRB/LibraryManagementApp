@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card card-form">
            <div class="card-body p-4">
                <h1 class="h3 mb-4"><i class="bi bi-key"></i> Alterar palavra-passe</h1>

                <form asp-action="ChangePassword" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="OldPassword" class="form-label"></label>
                        <input asp-for="OldPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="OldPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Confirm" class="form-label"></label>
                        <input asp-for="Confirm" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="Confirm" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="ChangeUser" class="btn btn-outline-secondary">Voltar</a>
                        <button type="submit" class="btn btn-primary">Alterar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
