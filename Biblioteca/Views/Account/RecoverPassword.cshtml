@model RecoverPasswordViewModel
@{
    ViewData["Title"] = "Recuperar palavra-passe";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card card-form">
            <div class="card-body p-4">
                <h1 class="h3 mb-3"><i class="bi bi-envelope"></i> Recuperar palavra-passe</h1>

                @if (ViewBag.Mensagem != null)
                {
                    <div class="alert alert-info" role="status">@ViewBag.Mensagem</div>

                    @if (ViewBag.LinkDemo != null)
                    {
                        <div class="alert alert-warning small">
                            <strong>Modo de desenvolvimento:</strong> o envio de email não está configurado.
                            Utilize esta ligação para continuar:<br />
                            <a href="@ViewBag.LinkDemo">Definir nova palavra-passe</a>
                        </div>
                    }

                    <a asp-action="Login" class="btn btn-outline-secondary w-100">Voltar ao login</a>
                }
                else
                {
                    <p class="text-muted">Indique o email da sua conta. Iremos enviar uma ligação para definir uma nova palavra-passe.</p>

                    <form asp-action="RecoverPassword" method="post" novalidate>
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Enviar</button>
                    </form>

                    <hr />
                    <p class="small text-center mb-0"><a asp-action="Login">Voltar ao login</a></p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
