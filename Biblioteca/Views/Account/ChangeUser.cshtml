@model ChangeUserViewModel
@{
    ViewData["Title"] = "O meu perfil";
}
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card card-form">
            <div class="card-body p-4">
                <h1 class="h3 mb-1"><i class="bi bi-person-gear"></i> O meu perfil</h1>
                <p class="text-muted mb-4">@User.Identity?.Name</p>

                <form asp-action="ChangeUser" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="ChangePassword" class="btn btn-outline-secondary"><i class="bi bi-key"></i> Alterar palavra-passe</a>
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}