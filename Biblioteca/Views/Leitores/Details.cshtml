@model Leitor
@{
    ViewData["Title"] = Model.Nome;
    var returnUrl = Url.Action("Details", new { id = Model.Id });
}
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Leitores</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Nome</li>
    </ol>
</nav>

<div class="card mb-4">
    <div class="card-body">
        <div class="d-flex flex-wrap justify-content-between gap-2">
            <h1 class="h2">@Model.Nome</h1>
            <div class="text-nowrap">
                <a asp-controller="Emprestimos" asp-action="Create" asp-route-leitorId="@Model.Id" class="btn btn-success"><i class="bi bi-plus-lg"></i> Novo empréstimo</a>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i> Editar</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
            </div>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Telefone</dt>
            <dd class="col-sm-9">@(Model.Telefone ?? "—")</dd>
            <dt class="col-sm-3">Leitor desde</dt>
            <dd class="col-sm-9">@Model.DataRegisto.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Empréstimos ativos</dt>
            <dd class="col-sm-9">@Model.Emprestimos.Count(e => !e.Devolvido)</dd>
        </dl>
    </div>
</div>

<h2 class="h4">Empréstimos (@Model.Emprestimos.Count)</h2>
@if (!Model.Emprestimos.Any())
{
    <p class="text-muted">Este leitor ainda não fez empréstimos.</p>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Livro</th>
                        <th>Autor</th>
                        <th>Empréstimo</th>
                        <th>Devolução prevista</th>
                        <th>Estado</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model.Emprestimos.OrderBy(e => e.Devolvido).ThenByDescending(e => e.DataEmprestimo))
                    {
                        <tr>
                            <td><a asp-controller="Livros" asp-action="Details" asp-route-id="@e.LivroId">@e.Livro?.Titulo</a></td>
                            <td>@e.Livro?.Autor?.Nome</td>
                            <td>@e.DataEmprestimo.ToString("dd/MM/yyyy")</td>
                            <td>@e.DataPrevistaDevolucao.ToString("dd/MM/yyyy")</td>
                            <td><partial name="_EstadoEmprestimo" model="e" /></td>
                            <td class="text-end">
                                @if (!e.Devolvido)
                                {
                                    <form asp-controller="Emprestimos" asp-action="Devolver" asp-route-id="@e.Id" method="post" class="d-inline">
                                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                                        <button type="submit" class="btn btn-sm btn-success"><i class="bi bi-box-arrow-in-down"></i> Devolver</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
