@{
    ViewData["Title"] = "Erro";
}
<div class="pagina-erro text-center">
    <i class="bi bi-exclamation-octagon display-3 text-danger" aria-hidden="true"></i>
    <h1 class="mt-3">Ocorreu um erro</h1>
    <p class="text-muted">Não foi possível processar o seu pedido. Por favor, tente novamente mais tarde.</p>
    @if (ViewBag.StatusCode != null)
    {
        <p class="small text-muted">Código: @ViewBag.StatusCode</p>
    }
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ir para o início</a>
</div>
