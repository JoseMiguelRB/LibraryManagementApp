@model Emprestimo
@{
    ViewData["Title"] = "Novo empréstimo";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-form">
            <div class="card-body p-4">
                <h1 class="h3 mb-4">Novo empréstimo</h1>

                <form asp-action="Create" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="LivroId" class="form-label"></label>
                        <select asp-for="LivroId" asp-items="ViewBag.Livros" class="form-select">
                            <option value="">-- Selecione o livro --</option>
                        </select>
                        <div class="form-text">Só são apresentados livros com exemplares disponíveis.</div>
                        <span asp-validation-for="LivroId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LeitorId" class="form-label"></label>
                        <select asp-for="LeitorId" asp-items="ViewBag.Leitores" class="form-select">
                            <option value="">-- Selecione o leitor --</option>
                        </select>
                        <span asp-validation-for="LeitorId" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-sm-6 mb-3">
                            <label asp-for="DataEmprestimo" class="form-label"></label>
                            <input asp-for="DataEmprestimo" class="form-control" />
                            <span asp-validation-for="DataEmprestimo" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6 mb-3">
                            <label asp-for="DataPrevistaDevolucao" class="form-label"></label>
                            <input asp-for="DataPrevistaDevolucao" class="form-control" />
                            <span asp-validation-for="DataPrevistaDevolucao" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary">Registar empréstimo</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
