@model Autor
<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div class="mb-3">
    <label asp-for="Nome" class="form-label"></label>
    <input asp-for="Nome" class="form-control" />
    <span asp-validation-for="Nome" class="text-danger small"></span>
</div>

<div class="row">
    <div class="col-sm-6 mb-3">
        <label asp-for="Nacionalidade" class="form-label"></label>
        <input asp-for="Nacionalidade" class="form-control" />
        <span asp-validation-for="Nacionalidade" class="text-danger small"></span>
    </div>
    <div class="col-sm-6 mb-3">
        <label asp-for="DataNascimento" class="form-label"></label>
        <input asp-for="DataNascimento" class="form-control" />
        <span asp-validation-for="DataNascimento" class="text-danger small"></span>
    </div>
</div>
