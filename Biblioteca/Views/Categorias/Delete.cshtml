@model Categoria
@{
    ViewData["Title"] = "Eliminar categoria";
}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger"><i class="bi bi-trash"></i> Eliminar categoria</h1>

                @if (Model.Livros.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-triangle"></i>
                        Esta categoria tem <strong>@Model.Livros.Count livro(s)</strong> associado(s) e não pode ser eliminada.
                    </div>
                }
                else
                {
                    <p>Tem a certeza de que pretende eliminar esta categoria?</p>
                }

                <dl class="row">
                    <dt class="col-sm-4">Nome</dt>
                    <dd class="col-sm-8">@Model.Nome</dd>
                    <dt class="col-sm-4">Descrição</dt>
                    <dd class="col-sm-8">@(Model.Descricao ?? "—")</dd>
                </dl>

                <form asp-action="Delete" method="post" class="d-flex justify-content-between">
                    <input type="hidden" asp-for="Id" />
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-danger" disabled="@Model.Livros.Any()">Eliminar</button>
                </form>
            </div>
        </div>
    </div>
</div>
